    "snake_case",
    "PascalCase",
    "kebab-case",
    "train-case",
    "title-case",
    "sentence-case",
    "constant-case",
    "spongeCase",
    "swapCase",
    "upper-case",
    "lower-case",
    "text transform",
    "case transformation",
    "typescript",
    "javascript",
    "convert case",
    "string casing",
    "camel",
    "capital",
    "constant",
    "dot",
    "no",
    "pascal",
    "path",
    "sentence",
    "snake",
    "train",
    "kebab",
    "sponge",
    "swap",
    "title",
    "upper",
    "locale-upper",
    "lower",
    "locale-lower",
    "lower-first",
    "upper-first",
    "is-upper",
    "is-lower"
